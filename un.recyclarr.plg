<!-- Description -->
<FILE Name="&emhttp;/README.md">
<INLINE>
**Recyclarr**

Automatically sync TRaSH guides to your Sonarr and Radarr instances. Allows you to create and edit config files via web interface.
</INLINE>
</FILE>

<!-- pre-install -->
<FILE Run="/bin/bash">
<INLINE>
echo ""
echo "+=================================+"
echo "| un.recyclarr version &version; |"
echo "+=================================+"
echo ""

echo "Removing old versions"
find &flash; -type f -name "&name;-*.txz" ! -name "&name;-&version;.txz" -delete

echo "Cleaning cache"
rm -rf &flash;/cache &appdata;/cache &appdata;/repo*
</INLINE>
</FILE>

<!-- install -->
<FILE Name="&flash;/&name;-&version;.txz" Run="upgradepkg --install-new --reinstall">
<URL>&gitURL;/releases/download/&version;/&name;.txz</URL>
<MD5>&md5;</MD5>
</FILE>

<!-- post-install -->
<FILE Run="/bin/bash">
<INLINE>
echo "Creating folders and files"
install -dm644 &flash;/{configs,includes,state} &appdata;/logs /var/log/recyclarr
if [[ ! -f &flash;/secrets.yml ]]; then
  install -m600 /dev/null &flash;/secrets.yml
fi
if [[ ! -f &flash;/settings.yml ]]; then
  install -m600 /dev/null &flash;/settings.yml
fi

echo "Pointing symlinks to flash"
ln -sf &flash;/secrets.yml &appdata;/
ln -sf &flash;/settings.yml &appdata;/
ln -sf &flash;/configs -T &appdata;/configs
ln -sf &flash;/includes -T &appdata;/includes
ln -sf &flash;/state -T &appdata;/state

echo "Pointing logs to /var/log"
ln -sf /var/log/recyclarr &appdata;/logs/cli

echo ""
echo "+=================================+"
echo "| un.recyclarr has been installed |"
echo "+=================================+"
echo ""
</INLINE>
</FILE>

<!-- remove -->
<FILE Run="/bin/bash" Method="remove">
<INLINE>
removepkg &name;-&version;
rm -rf &emhttp; &appdata; &flash;/*.{cron,txz} /var/log/recyclarr
/usr/local/sbin/update_cron

echo ""
echo "+===============================+"
echo "| un.recyclarr has been removed |"
echo "+===============================+"
echo ""
</INLINE>
</FILE>
</PLUGIN>
